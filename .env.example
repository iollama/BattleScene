# For Google sign-in, set the exact origin of your deployment, without a trailing slash.
APP_ORIGIN=http://127.0.0.1:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=
BOOTSTRAP_ADMIN_EMAIL=
# Set automatically when a private Vercel Blob store is linked. Use either one: a read-write token, or an
# OIDC-linked store, which sets BLOB_STORE_ID instead. If both are set, the token is used.
BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=
