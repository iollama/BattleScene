{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:route*", "destination": "/api/dispatch?path=:route*" },
    { "source": "/watch/:path*", "destination": "/index.html" },
    { "source": "/register/:path*", "destination": "/index.html" },
    { "source": "/manage/:path*", "destination": "/index.html" }
  ]
}
